---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  image: ImageMetadata;
  href: string;
  alt?: string;
  class?: string;
}

const { href, image, alt = "", class: className, ...rest } = Astro.props;
---

<a
  href={href}
  class:list={[
    "inline-flex items-center justify-center gap-2 py-2 px-5",
    "bg-black text-white rounded-full transition-colors hover:bg-gray-700",
    "focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black",
    className,
  ]}
  {...rest}
>
  <Image src={image} alt={alt} width={24} height={24} class="shrink-0" />
  <span class="font-medium">
    <slot />
  </span>
</a>
